# PostgreSQL (Neon recomendado). Use a URL pooled fornecida pelo provedor.
DATABASE_URL=postgresql://...
# Pool conservador por instância serverless
DATABASE_POOL_MAX=2
# Somente para PostgreSQL local sem TLS:
# DATABASE_SSL=disable

# Long random secret used to sign HttpOnly sessions (32+ chars)
AUTH_SECRET=change-this-to-a-long-random-string-with-32-chars

# One-time master account bootstrap (32+ chars)
MASTER_BOOTSTRAP_SECRET=change-this-too-with-at-least-32-chars

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Public Vercel URL
APP_URL=https://seu-projeto.vercel.app
